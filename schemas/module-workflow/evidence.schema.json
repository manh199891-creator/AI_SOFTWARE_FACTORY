{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Schema",
  "type": "object",
  "description": "Evidence collected prior to making code changes",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "repository_root": { "type": "string", "const": "." },
    "branch": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "module_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan_lock_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generated_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },

    "ready_to_implement": { "type": "boolean" },
    "files_verified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:).*$"
          },
          "exists": { "type": "boolean" },
          "tracked": { "type": "boolean" },
          "file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "evidence_command": { "type": "string" }
        },
        "required": ["path", "exists", "tracked", "evidence_command"],
        "additionalProperties": false
      }
    },
    "symbols_verified": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string" },
          "evidence_command": { "type": "string" },
          "matches": {
            "type": "array",
            "items": { "type": "string" }
          },
          "found_count": { "type": "integer", "minimum": 0 }
        },
        "required": ["symbol", "evidence_command", "matches", "found_count"],
        "additionalProperties": false
      }
    },
    "diagnosis": { "type": "string" },
    "diagnosis_sources": {
      "type": "array",
      "items": {

        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:).*$"
          },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "excerpt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "required": ["path", "line_start", "line_end", "reason", "file_sha256", "excerpt_sha256"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "repository_root",
    "branch",
    "task_id",
    "module_id",
    "base_commit",
    "task_sha256",
    "scope_sha256",
    "plan_sha256",
    "plan_lock_sha256",
    "source_snapshot_sha256",
    "generated_at",
    "ready_to_implement",
    "files_verified",
    "symbols_verified",
    "diagnosis",
    "diagnosis_sources"
  ],
  "additionalProperties": false
}
