{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan Lock Schema",
  "type": "object",
  "description": "Lock file for approved task, scope, and plan",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "module_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "branch": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "base_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval_file": { "type": "string", "minLength": 1 },
    "approval_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approval_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "locked_by": { "type": "string", "const": "codex" },
    "locked_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },
    "plan_status": { "type": "string", "const": "APPROVED" },
    "approved_by": { "type": "string", "const": "codex" },
    "approved_review_run": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}" },
    "amendment_count": { "type": "integer", "minimum": 0 }

  },
  "required": [
    "schema_version",
    "module_id",
    "branch",
    "task_id",
    "base_commit",
    "task_sha256",
    "scope_sha256",
    "plan_sha256",
    "approval_file",
    "approval_sha256",
    "approval_commit",
    "locked_by",
    "locked_at",
    "plan_status",
    "approved_by",
    "approved_review_run",
    "approved_at",
    "amendment_count"
  ],
  "additionalProperties": false
}
