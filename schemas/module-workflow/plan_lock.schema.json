{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan Lock Schema",
  "type": "object",
  "description": "Lock file for approved task, scope, and plan",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "plan_status": { "type": "string", "const": "APPROVED" },
    "task_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "plan_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "approved_by": { "type": "string", "const": "codex" },
    "approved_review_run": { "type": "string", "minLength": 1 },
    "approved_at": { "type": "string", "format": "date-time" },
    "base_commit": { "type": "string" },
    "amendment_count": { "type": "integer", "minimum": 0 }
  },
  "required": [
    "schema_version",
    "task_id",
    "plan_status",
    "task_sha256",
    "scope_sha256",
    "plan_sha256",
    "approved_by",
    "approved_review_run",
    "approved_at",
    "base_commit",
    "amendment_count"
  ],
  "additionalProperties": false
}
