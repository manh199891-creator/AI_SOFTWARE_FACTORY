{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence Request Schema",
  "type": "object",
  "description": "Temporary input prepared by Antigravity in .sandbox for Evidence Gate",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "module_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "files_to_verify": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)[^/].*"
      }
    },
    "symbols_to_verify": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)[^/].*"
            }
          }
        },
        "required": ["symbol", "paths"],
        "additionalProperties": false
      }
    },
    "diagnosis": {
      "type": "string",
      "minLength": 20
    },
    "diagnosis_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*\\.\\.)(?!.*:)[^/].*"
          },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "required": ["path", "line_start", "line_end", "reason"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "module_id",
    "files_to_verify",
    "symbols_to_verify",
    "diagnosis",
    "diagnosis_sources"
  ],
  "additionalProperties": false
}
