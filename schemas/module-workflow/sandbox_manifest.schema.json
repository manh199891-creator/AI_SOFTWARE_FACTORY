{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sandbox Manifest Schema",
  "type": "object",
  "description": "Manifest binding sandbox DLL to source snapshot",
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "task_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "module_id": { "type": "string" },
    "branch": { "type": "string" },
    "source_commit": { "type": "string" },
    "source_snapshot_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "configuration": { "type": "string", "enum": ["Debug", "Release"] },
    "project_file": { "type": "string" },
    "dll": { "type": "string" },
    "dll_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "built_at": { "type": "string", "format": "date-time" },
    "test_status": { "type": "string", "enum": ["PENDING", "PASS", "FAIL"] },
    "test_results": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "module_id",
    "branch",
    "source_commit",
    "source_snapshot_sha256",
    "configuration",
    "project_file",
    "dll",
    "dll_sha256",
    "built_at",
    "test_status",
    "test_results"
  ],
  "additionalProperties": false
}
